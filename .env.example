# SAGE environment variables
# Copy to .env and replace every change-me value:
#   cp .env.example .env
# Generate strong values with:  openssl rand -hex 20
# Never commit .env. It is listed in .gitignore.

# ── Grafana ──────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ── PostgreSQL ───────────────────────────────────────
# Superuser (administration only)
POSTGRES_USER=master
POSTGRES_PASSWORD=change-me
# Application user, owner of the sage database
POSTGRES_SAGE_USER=sage
POSTGRES_SAGE_PASSWORD=change-me

# ── Redis ────────────────────────────────────────────
REDIS_PASSWORD=change-me


# ── Object storage (SeaweedFS S3) ──────────────────
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
